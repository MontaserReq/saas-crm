# Copy this file to .env on the server, then replace every placeholder.
# Never commit the server's real .env file.

# Compose database settings. DATABASE_URL must use the service hostname `db`.
POSTGRES_USER=codeline_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=codelinecrm
DATABASE_URL=postgresql://codeline_app:replace-with-a-long-random-database-password@db:5432/codelinecrm?schema=public

# Public canonical URL. All three values must be the same HTTPS origin.
APP_ORIGIN=https://app.satrcrm.com
APP_URL=https://app.satrcrm.com
NEXT_PUBLIC_APP_URL=https://app.satrcrm.com

# Remote MCP. Keep empty unless a browser-based MCP client must call directly;
# server-to-server clients authenticate with Bearer tokens and do not need an
# Origin allowlist.
MCP_ALLOWED_ORIGINS=
MCP_SERVER_VERSION=1.0.0

# Optional GA4 Measurement ID, for example G-XXXXXXXXXX. This is a public
# identifier, but tracking waits for consent in the browser.
GA_MEASUREMENT_ID=

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# The app is private behind exactly one reverse proxy that terminates TLS.
TRUST_PROXY=single-hop

# File storage. This local mode survives container restarts through the
# uploads_data volume. Use S3-compatible storage for multiple app instances.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/uploads
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false

# SMTP is optional, but required for password-reset email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tech@codelinejo.com
SMTP_PASSWORD=
EMAIL_FROM=tech@codelinejo.com
EMAIL_FROM_NAME=SatrCRM Monitoring

# Uptime and application error alerts. Keep SMTP_PASSWORD server-side only.
ALERT_EMAIL_TO=tech@codelinejo.com
MONITOR_URLS=https://satrcrm.com/api/health,https://satrcrm.com/,https://app.satrcrm.com/
MONITOR_INTERVAL_SECONDS=60
MONITOR_TIMEOUT_MS=10000
MONITOR_FAILURE_THRESHOLD=1
MONITOR_RECOVERY_THRESHOLD=1

# Optional Google/Microsoft calendar and email integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EMAIL_INTEGRATION_PENDING_REVIEW=true
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Register this callback in Canva Developer Portal:
# ${CANVA_REDIRECT_URI}
CANVA_REDIRECT_URI=https://app.satrcrm.com/api/integrations/canva/callback
INTEGRATION_ENCRYPTION_KEY=

# Slack workspace integration (server-side only). Configure the Slack app's
# OAuth redirect URL as: ${APP_URL}/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Optional AI providers. Leave empty to keep AI features disabled.
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
GROQ_MAX_COMPLETION_TOKENS=4096
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_ASSISTANT_MODEL=llama-3.1-8b-instant
GEMINI_ASSISTANT_MODEL=gemini-2.0-flash-lite

# Optional chatbot proxy. Leave empty to fail closed.
CHATBOT_UPSTREAM_ORIGIN=
CHATBOT_WIDGET_URL=
CHATBOT_PROXY_ALLOWED_PATHS=
