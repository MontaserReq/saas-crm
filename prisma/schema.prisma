generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  avatar       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  accessMode   String    @default("ANY_IP") // ANY_IP | RESTRICTED_IPS
  allowedIps   String? // JSON array; retained independently from login history

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // Independent reporting hierarchy (separate from roles and permissions)
  reportsToUserId String?
  reportsTo       User?   @relation("UserReporting", fields: [reportsToUserId], references: [id], onDelete: SetNull)
  directReports   User[]  @relation("UserReporting")

  // Relations
  ticketAssignees               TicketAssignee[]
  createdTickets                Ticket[]                  @relation("TicketCreator")
  createdAssignments            SchoolAssignment[]        @relation("AssignmentCreator")
  notes                         Note[]                    @relation("NoteAuthor")
  communicationAttempts         CommunicationAttempt[]    @relation("AttemptAuthor")
  assignmentHistoryFrom         AssignmentHistory[]       @relation("AssignFrom")
  assignmentHistoryTo           AssignmentHistory[]       @relation("AssignTo")
  assignmentHistoryAction       AssignmentHistory[]       @relation("AssignPerformed")
  notifications                 Notification[]
  auditLogs                     AuditLog[]                @relation("AuditActor")
  activityEvents                ActivityEvent[]           @relation("ActivityActor")
  todos                         Todo[]                    @relation("UserTodos")
  createdSchools                School[]                  @relation("SchoolCreator")
  responsibleSchools            School[]                  @relation("SchoolResponsible")
  createdClients                Client[]                  @relation("ClientCreator")
  updatedClients                Client[]                  @relation("ClientUpdater")
  assignedLeads                 Lead[]                    @relation("LeadAssignee")
  assignedContacts              Contact[]                 @relation("ContactAssignee")
  ownedDeals                    Deal[]                    @relation("DealOwner")
  createdDeals                  Deal[]                    @relation("DealCreator")
  dealAssignments               DealAssignee[]
  ownedCrmTasks                 CrmTask[]                 @relation("CrmTaskOwner")
  assignedCrmTasks              CrmTask[]                 @relation("CrmTaskAssignee")
  createdCrmTasks               CrmTask[]                 @relation("CrmTaskCreator")
  managedDepartments            DepartmentManager[]
  sentMessages                  Message[]                 @relation("SentMessages")
  receivedMessages              MessageRecipient[]        @relation("ReceivedMessages")
  chatMemberships               ChatParticipant[]
  sentChatMessages              ChatMessage[]             @relation("ChatMessageSender")
  loginSessions                 LoginSession[]
  passwordResetTokens           PasswordResetToken[]
  schoolApprovalRequests        SchoolApprovalRequest[]   @relation("SchoolApprovalRequester")
  schoolApprovalDecisions       SchoolApprovalRequest[]   @relation("SchoolApprovalDecider")
  ticketApprovalRequests        TicketApprovalRequest[]   @relation("TicketApprovalRequester")
  ticketApprovalDecisions       TicketApprovalRequest[]   @relation("TicketApprovalDecider")
  assignedCalendarEvents        CalendarEvent[]           @relation("CalendarAssignedUser")
  createdCalendarEvents         CalendarEvent[]           @relation("CalendarCreator")
  calendarEventAssignees        CalendarEventAssignee[]
  taskTypeMemberships           TaskTypeMember[]
  schoolResearchJobs            SchoolResearchJob[]       @relation("SchoolResearchJobCreator")
  schoolResearchDecisions       SchoolResearchCandidate[] @relation("SchoolResearchCandidateDecider")
  createdMeetingDetails         MeetingDetails[]
  presence                      UserPresence?
  createdProposals              Proposal[]                @relation("ProposalCreator")
  createdProposalTemplates      ProposalTemplate[]        @relation("ProposalTemplateCreator")
  createdCustomFieldDefinitions CustomFieldDefinition[]   @relation("CustomFieldDefinitionCreatedBy")
  updatedCustomFieldDefinitions CustomFieldDefinition[]   @relation("CustomFieldDefinitionUpdatedBy")
  createdWorkflows              Workflow[]                @relation("WorkflowCreatedBy")
  updatedWorkflows              Workflow[]                @relation("WorkflowUpdatedBy")

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  userPermissions         UserPermission[]
  organizationMemberships OrganizationMember[]
  teamMemberships         TeamMember[]
  sentInvitations         OrganizationInvite[] @relation("InvitationSender")
  receivedInvitations     OrganizationInvite[] @relation("InvitationRecipient")
  operationExecutions     OperationExecution[] @relation("OperationExecutionUser")

  @@index([roleId])
  @@index([departmentId])
  @@index([reportsToUserId])
  @@index([email])
}

// Multi-tenant foundation. Legacy business records are backfilled to the
// imported CodeLine organization by migration and will be progressively
// migrated to required organization ownership in later migrations.
model Organization {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  logoKey      String?
  logoProvider String  @default("local")
  primaryColor String?
  timezone     String  @default("UTC")
  currency     String  @default("USD")
  language     String  @default("en")
  isActive     Boolean @default(true)

  members                OrganizationMember[]
  teams                  Team[]
  settings               OrganizationSettings?
  invitations            OrganizationInvite[]
  departments            Department[]
  schools                School[]
  researchJobs           SchoolResearchJob[]
  assignments            SchoolAssignment[]
  taskTypes              TaskType[]
  tickets                Ticket[]
  ticketApprovalRequests TicketApprovalRequest[]
  schoolApprovalRequests SchoolApprovalRequest[]
  chatConversations      ChatConversation[]
  calendarEvents         CalendarEvent[]
  messageTemplates       MessageTemplate[]
  proposalTemplates      ProposalTemplate[]
  proposals              Proposal[]
  attachments            Attachment[]
  messageAttachments     MessageAttachment[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  activityEvents         ActivityEvent[]
  todos                  Todo[]
  messages               Message[]
  clients                Client[]                @relation("ClientOrganization")
  leads                  Lead[]
  contacts               Contact[]
  pipelines              Pipeline[]
  pipelineStages         PipelineStage[]
  deals                  Deal[]
  crmTasks               CrmTask[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  workflows              Workflow[]
  workflowExecutions     WorkflowExecution[]
  operationExecutions    OperationExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String?
  role           Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status         String       @default("ACTIVE") // INVITED | ACTIVE | SUSPENDED | REMOVED
  lastActiveAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model Team {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  isActive         Boolean      @default(true)
  members          TeamMember[]
  assignedLeads    Lead[]       @relation("LeadTeam")
  assignedDeals    Deal[]       @relation("DealTeam")
  assignedCrmTasks CrmTask[]    @relation("CrmTaskTeam")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // OWNER | MEMBER | VIEWER
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model OrganizationSettings {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabledModules          String       @default("[]")
  clientTypes             String       @default("[]")
  leadStatuses            String       @default("[]")
  ticketStatuses          String       @default("[]")
  notificationPreferences String       @default("{}")
  dateFormat              String       @default("yyyy-MM-dd")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

model CustomFieldDefinition {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  key            String
  label          String
  description    String?
  fieldType      String
  required       Boolean            @default(false)
  active         Boolean            @default(true)
  searchable     Boolean            @default(false)
  displayOrder   Int                @default(0)
  options        Json?
  createdById    String?
  createdBy      User?              @relation("CustomFieldDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?              @relation("CustomFieldDefinitionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  archivedAt     DateTime?
  values         CustomFieldValue[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType, active, displayOrder])
}

model CustomFieldValue {
  id                String                @id @default(cuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  entityType        String
  entityId          String
  valueText         String?
  valueNumber       Decimal?
  valueBoolean      Boolean?
  valueDate         DateTime?
  valueJson         Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([organizationId, fieldDefinitionId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, fieldDefinitionId])
}

model Workflow {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  entityType      String
  triggerType     String
  conditions      Json
  actions         Json
  executionConfig Json?
  isActive        Boolean             @default(false)
  archivedAt      DateTime?
  createdById     String
  createdBy       User                @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById     String
  updatedBy       User                @relation("WorkflowUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  executions      WorkflowExecution[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive, entityType, triggerType])
  @@index([organizationId, archivedAt])
}

model WorkflowExecution {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  eventId        String
  eventType      String
  entityType     String
  entityId       String
  status         String       @default("PENDING")
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  retryCount     Int          @default(0)
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, workflowId, eventId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, workflowId, createdAt])
  @@index([organizationId, eventType, entityType, entityId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  roleId         String?
  role           Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  invitedById    String
  invitedBy      User         @relation("InvitationSender", fields: [invitedById], references: [id])
  invitedUserId  String?
  invitedUser    User?        @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@index([expiresAt])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // SUPER_ADMIN, ADMIN, SCHOOL_MANAGER, MEMBER
  displayName String
  description String?
  isSystem    Boolean @default(false)

  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]
  users               User[]
  organizationMembers OrganizationMember[]
  organizationInvites OrganizationInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. "tickets.view_assigned", "tickets.view_all"
  name        String
  module      String // "tickets", "schools", "assignments", "users", "roles", "departments", "task_types", "analytics", "audit_logs", "todos"
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  Role         Role?      @relation(fields: [roleId], references: [id])
  roleId       String?

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model Department {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  code           String        @unique // "PR", "SCHOOL_OUTREACH", "VISITS", "DATA_COLLECTION", "NGOS", "MANAGEMENT", "MEDIA"
  description    String?
  isActive       Boolean       @default(true)

  users     User[]
  managers  DepartmentManager[]
  tickets   Ticket[]
  taskTypes TaskType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isActive])
}

// Canonical generic CRM customer. School remains as a compatibility profile
// during the expand-and-migrate period; migrated School rows use the same id
// in Client so existing URLs and foreign keys remain stable.
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("ClientOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  type           String       @default("OTHER") // SCHOOL | COMPANY | NGO | UNIVERSITY | GOVERNMENT | INDIVIDUAL | OTHER
  status         String       @default("ACTIVE") // ACTIVE | INACTIVE | PROSPECT | ARCHIVED
  description    String?
  category       String?
  website        String?
  email          String?
  phone          String?
  address        String?
  logoKey        String?
  logoProvider   String       @default("local")
  createdById    String?
  createdBy      User?        @relation("ClientCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?        @relation("ClientUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt      DateTime?

  leads          Lead[]          @relation("LeadClient")
  contacts       Contact[]       @relation("ContactClient")
  convertedLeads Lead[]          @relation("LeadConvertedClient")
  deals          Deal[]
  crmTasks       CrmTask[]
  tickets        Ticket[]
  proposals      Proposal[]
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, name])
}

model Lead {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name               String
  companyName        String?
  email              String?
  phone              String?
  source             String?
  status             String       @default("NEW") // NEW | CONTACTED | QUALIFIED | UNQUALIFIED | CONVERTED | LOST
  notes              String?
  assignedUserId     String?
  assignedUser       User?        @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedTeamId     String?
  assignedTeam       Team?        @relation("LeadTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  convertedClientId  String?
  convertedClient    Client?      @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedContactId String?
  convertedContact   Contact?     @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  clientId           String?
  client             Client?      @relation("LeadClient", fields: [clientId], references: [id], onDelete: SetNull)
  deals              Deal[]
  crmTasks           CrmTask[]
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, assignedTeamId])
  @@index([organizationId, clientId])
}

model Contact {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clientId           String?
  client             Client?      @relation("ContactClient", fields: [clientId], references: [id], onDelete: SetNull)
  firstName          String
  lastName           String?
  jobTitle           String?
  email              String?
  phone              String?
  mobile             String?
  isPrimary          Boolean      @default(false)
  notes              String?
  assignedUserId     String?
  assignedUser       User?        @relation("ContactAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  convertedFromLeads Lead[]       @relation("LeadConvertedContact")
  deals              Deal[]       @relation("DealContact")
  crmTasks           CrmTask[]    @relation("CrmTaskContact")
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, clientId])
  @@index([organizationId, email])
  @@index([organizationId, assignedUserId])
}

model Pipeline {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  stages         PipelineStage[]
  deals          Deal[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, isDefault])
}

model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  name           String
  order          Int
  probability    Int          @default(0)
  type           String       @default("OPEN")
  isActive       Boolean      @default(true)
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([pipelineId, name])
  @@unique([pipelineId, order])
  @@index([organizationId, pipelineId, order])
}

model Deal {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title             String
  description       String?
  clientId          String?
  client            Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  primaryContactId  String?
  primaryContact    Contact?       @relation("DealContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  leadId            String?
  lead              Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  pipelineId        String
  pipeline          Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stageId           String
  stage             PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  status            String         @default("OPEN")
  value             Decimal?
  currency          String         @default("USD")
  probability       Int?
  expectedCloseDate DateTime?
  ownerId           String
  owner             User           @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  teamId            String?
  team              Team?          @relation("DealTeam", fields: [teamId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User           @relation("DealCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments       DealAssignee[]
  tasks             CrmTask[]
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, pipelineId, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt])
}

model DealAssignee {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([dealId, userId])
  @@index([userId])
}

model CrmTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  status         String       @default("TODO")
  priority       String       @default("MEDIUM")
  dueDate        DateTime?
  ownerId        String?
  owner          User?        @relation("CrmTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignedUserId String?
  assignedUser   User?        @relation("CrmTaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedTeamId String?
  assignedTeam   Team?        @relation("CrmTaskTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User         @relation("CrmTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation("CrmTaskContact", fields: [contactId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  ticketId       String?
  ticket         Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  completedAt    DateTime?
  cancelledAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, assignedTeamId])
  @@index([organizationId, dueDate])
  @@index([organizationId, createdAt])
}

model DepartmentManager {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@index([userId])
}

model School {
  id                String        @id @default(cuid())
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name              String
  contactPerson     String?
  phone             String?
  whatsapp          String?
  email             String?
  city              String
  area              String?
  schoolType        String        @default("PRIVATE") // "PRIVATE", "GOVERNMENT", "INTERNATIONAL", "COMMUNITY", "OTHER"
  classification    String        @default("A") // "A", "B", "C"
  notes             String?
  status            String        @default("ACTIVE") // "ACTIVE", "INACTIVE", "CONTACTED", "ASSIGNED"
  isDeleted         Boolean       @default(false)
  isPublic          Boolean       @default(false)
  publicDescription String?
  deletedAt         DateTime?

  responsibleEmployeeId String?
  responsibleEmployee   User?   @relation("SchoolResponsible", fields: [responsibleEmployeeId], references: [id])

  createdById String?
  createdBy   User?   @relation("SchoolCreator", fields: [createdById], references: [id])

  tickets                  Ticket[]
  calendarEvents           CalendarEvent[]
  approvalRequests         SchoolApprovalRequest[]
  researchCandidateMatches SchoolResearchCandidate[]

  logoKey      String?
  logoProvider String  @default("local")

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  proposals Proposal[]

  @@index([city])
  @@index([status])
  @@index([schoolType])
  @@index([classification])
  @@index([responsibleEmployeeId])
  @@index([isDeleted])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

// AI School Research: research/discovery workspace. Candidates here are
// unverified AI-discovered leads and are never treated as official School
// records until a human explicitly approves one (see SchoolResearchCandidate.status).
model SchoolResearchJob {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User          @relation("SchoolResearchJobCreator", fields: [createdById], references: [id])

  mode           String  @default("FIND_NEW") // FIND_NEW | ENRICH_EXISTING | VERIFY_EXISTING
  status         String  @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  location       String
  area           String?
  schoolType     String?
  requestedCount Int
  requiredFields String // JSON array, e.g. ["phone","email","website"]
  error          String?
  aiCallCount    Int     @default(0)
  sourceCount    Int     @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  currentOperationId String?
  currentOperation   OperationExecution? @relation("ResearchJobCurrentOperation", fields: [currentOperationId], references: [id], onDelete: SetNull)

  candidates SchoolResearchCandidate[]
  attempts   SchoolResearchAttempt[]

  @@index([createdById, createdAt])
  @@index([status])
  @@unique([currentOperationId])
}

model SchoolResearchCandidate {
  id            String            @id @default(cuid())
  researchJobId String
  researchJob   SchoolResearchJob @relation(fields: [researchJobId], references: [id], onDelete: Cascade)

  name           String
  normalizedName String
  city           String?
  area           String?
  phone          String?
  email          String?
  website        String?
  contactPerson  String?
  schoolType     String?
  address        String?
  confidence     Int     @default(0)
  status         String  @default("NEW") // NEW | NEEDS_REVIEW | DUPLICATE | APPROVED | REJECTED | IMPORTED

  matchedSchoolId String?
  matchedSchool   School? @relation(fields: [matchedSchoolId], references: [id])

  rejectionReason  String?
  researchNotes    String?
  importedSchoolId String? @unique

  decidedById String?
  decidedBy   User?     @relation("SchoolResearchCandidateDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  sources SchoolResearchSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([researchJobId, status])
  @@index([normalizedName])
  @@index([matchedSchoolId])
}

model SchoolResearchSource {
  id          String                  @id @default(cuid())
  candidateId String
  candidate   SchoolResearchCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  field       String // "name" | "phone" | "email" | "website" | "address" | "schoolType" | "contactPerson"
  sourceType  String // "OFFICIAL_WEBSITE" | "SEARCH_GROUNDING" | "OTHER"
  sourceUrl   String?
  collectedAt DateTime @default(now())

  @@index([candidateId])
}

// Per-API-request usage tracking for AI School Research.
// One row per individual HTTP request to a provider (Groq or Gemini).
// A single research job may produce multiple rows (batches, retries, fallbacks).
// Web searches are tracked separately from API requests — a single Groq compound
// request may internally execute multiple web searches (see executedTools).
model SchoolResearchAttempt {
  id    String            @id @default(cuid())
  jobId String
  job   SchoolResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Provider identity
  provider String // "groq" | "gemini"
  model    String

  // Attempt numbering within this job (1-based, sequential across all providers)
  attemptNumber Int

  // Outcome
  status     String // "SUCCESS" | "FAILED" | "RATE_LIMITED"
  httpStatus Int? // HTTP status code, null on network errors

  // Timing (actual wall-clock, never estimated)
  durationMs  Int
  startedAt   DateTime
  completedAt DateTime

  // Token usage (null when the provider did not return them — never guessed)
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  // Tool executions within this API request
  // webSearches: count of search-type tools executed (NOT equal to apiRequests)
  webSearches   Int     @default(0)
  // executedTools: JSON array of raw tool metadata from Groq compound response
  executedTools String?

  // Classification flags
  isRetry    Boolean @default(false) // came after a RATE_LIMITED attempt
  isFallback Boolean @default(false) // Gemini attempt invoked after Groq failure

  // Error details (sanitized — no API keys or secrets)
  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model SchoolApprovalRequest {
  id              String        @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  schoolId        String
