  @@index([senderId])
}

// Real online/offline/away presence, driven by a client heartbeat (see
// PresenceService). Kept as its own single-row-per-user table rather than
// fields on User so frequent heartbeat writes never touch/lock the User row.
// Status itself is never stored — it's always derived from lastSeenAt at
// read time (PresenceService.deriveStatus), so a browser closed without a
// clean disconnect self-corrects to "offline" once the heartbeat stops,
// instead of getting stuck showing "online" forever.
model UserPresence {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime

  @@index([lastSeenAt])
}

