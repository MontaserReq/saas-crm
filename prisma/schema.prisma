  type            String // EDIT | DELETE
  status          String        @default("PENDING") // PENDING | APPROVED | REJECTED
  previousData    String?
  proposedData    String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  decidedAt       DateTime?

  @@index([status, type])
  @@index([schoolId, createdAt])
  @@index([requesterId])
}

model TicketApprovalRequest {
