generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  avatar       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  accessMode   String    @default("ANY_IP") // ANY_IP | RESTRICTED_IPS
  allowedIps   String? // JSON array; retained independently from login history

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // Independent reporting hierarchy (separate from roles and permissions)
  reportsToUserId String?
  reportsTo       User?   @relation("UserReporting", fields: [reportsToUserId], references: [id], onDelete: SetNull)
  directReports   User[]  @relation("UserReporting")

  // Relations
  ticketAssignees         TicketAssignee[]
  createdTickets          Ticket[]                  @relation("TicketCreator")
  createdAssignments      SchoolAssignment[]        @relation("AssignmentCreator")
  notes                   Note[]                    @relation("NoteAuthor")
  communicationAttempts   CommunicationAttempt[]    @relation("AttemptAuthor")
  assignmentHistoryFrom   AssignmentHistory[]       @relation("AssignFrom")
  assignmentHistoryTo     AssignmentHistory[]       @relation("AssignTo")
  assignmentHistoryAction AssignmentHistory[]       @relation("AssignPerformed")
  notifications           Notification[]
  auditLogs               AuditLog[]                @relation("AuditActor")
  activityEvents          ActivityEvent[]           @relation("ActivityActor")
  todos                   Todo[]                    @relation("UserTodos")
  createdSchools          School[]                  @relation("SchoolCreator")
  responsibleSchools      School[]                  @relation("SchoolResponsible")
  managedDepartments      DepartmentManager[]
  sentMessages            Message[]                 @relation("SentMessages")
  receivedMessages        MessageRecipient[]        @relation("ReceivedMessages")
  chatMemberships         ChatParticipant[]
  sentChatMessages        ChatMessage[]             @relation("ChatMessageSender")
  loginSessions           LoginSession[]
  passwordResetTokens     PasswordResetToken[]
  schoolApprovalRequests  SchoolApprovalRequest[]   @relation("SchoolApprovalRequester")
  schoolApprovalDecisions SchoolApprovalRequest[]   @relation("SchoolApprovalDecider")
  ticketApprovalRequests  TicketApprovalRequest[]   @relation("TicketApprovalRequester")
  ticketApprovalDecisions TicketApprovalRequest[]   @relation("TicketApprovalDecider")
  assignedCalendarEvents  CalendarEvent[]           @relation("CalendarAssignedUser")
  createdCalendarEvents   CalendarEvent[]           @relation("CalendarCreator")
  calendarEventAssignees  CalendarEventAssignee[]
  taskTypeMemberships     TaskTypeMember[]
  schoolResearchJobs      SchoolResearchJob[]       @relation("SchoolResearchJobCreator")
  schoolResearchDecisions SchoolResearchCandidate[] @relation("SchoolResearchCandidateDecider")
  createdMeetingDetails   MeetingDetails[]
  presence                UserPresence?
  createdProposals        Proposal[]                @relation("ProposalCreator")
  createdProposalTemplates ProposalTemplate[]       @relation("ProposalTemplateCreator")

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userPermissions UserPermission[]

  @@index([roleId])
  @@index([departmentId])
  @@index([reportsToUserId])
  @@index([email])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // SUPER_ADMIN, ADMIN, SCHOOL_MANAGER, MEMBER
  displayName String
  description String?
  isSystem    Boolean @default(false)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
  users           User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. "tickets.view_assigned", "tickets.view_all"
  name        String
  module      String // "tickets", "schools", "assignments", "users", "roles", "departments", "task_types", "analytics", "audit_logs", "todos"
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  Role         Role?      @relation(fields: [roleId], references: [id])
  roleId       String?

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model Department {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique // "PR", "SCHOOL_OUTREACH", "VISITS", "DATA_COLLECTION", "NGOS", "MANAGEMENT", "MEDIA"
  description String?
  isActive    Boolean @default(true)

  users     User[]
  managers  DepartmentManager[]
  tickets   Ticket[]
  taskTypes TaskType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepartmentManager {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@index([userId])
}

model School {
  id                String    @id @default(cuid())
  name              String
  contactPerson     String?
  phone             String?
  whatsapp          String?
  email             String?
  city              String
  area              String?
  schoolType        String    @default("PRIVATE") // "PRIVATE", "GOVERNMENT", "INTERNATIONAL", "COMMUNITY", "OTHER"
  classification    String    @default("A") // "A", "B", "C"
  notes             String?
  status            String    @default("ACTIVE") // "ACTIVE", "INACTIVE", "CONTACTED", "ASSIGNED"
  isDeleted         Boolean   @default(false)
  isPublic          Boolean   @default(false)
  publicDescription String?
  deletedAt         DateTime?

  responsibleEmployeeId String?
  responsibleEmployee   User?   @relation("SchoolResponsible", fields: [responsibleEmployeeId], references: [id])

  createdById String?
  createdBy   User?   @relation("SchoolCreator", fields: [createdById], references: [id])

  tickets                  Ticket[]
  calendarEvents           CalendarEvent[]
  approvalRequests         SchoolApprovalRequest[]
  researchCandidateMatches SchoolResearchCandidate[]

  logoKey      String?
  logoProvider String  @default("local")

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  proposals Proposal[]

  @@index([city])
  @@index([status])
  @@index([schoolType])
  @@index([classification])
  @@index([responsibleEmployeeId])
  @@index([isDeleted])
}

// AI School Research: research/discovery workspace. Candidates here are
// unverified AI-discovered leads and are never treated as official School
// records until a human explicitly approves one (see SchoolResearchCandidate.status).
model SchoolResearchJob {
  id          String @id @default(cuid())
  createdById String
  createdBy   User   @relation("SchoolResearchJobCreator", fields: [createdById], references: [id])

  mode           String  @default("FIND_NEW") // FIND_NEW | ENRICH_EXISTING | VERIFY_EXISTING
  status         String  @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  location       String
  area           String?
  schoolType     String?
  requestedCount Int
  requiredFields String // JSON array, e.g. ["phone","email","website"]
  error          String?
  aiCallCount    Int     @default(0)
  sourceCount    Int     @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  candidates SchoolResearchCandidate[]
  attempts   SchoolResearchAttempt[]

  @@index([createdById, createdAt])
  @@index([status])
}

model SchoolResearchCandidate {
  id            String            @id @default(cuid())
  researchJobId String
  researchJob   SchoolResearchJob @relation(fields: [researchJobId], references: [id], onDelete: Cascade)

  name           String
  normalizedName String
  city           String?
  area           String?
  phone          String?
  email          String?
  website        String?
  contactPerson  String?
  schoolType     String?
  address        String?
  confidence     Int     @default(0)
  status         String  @default("NEW") // NEW | NEEDS_REVIEW | DUPLICATE | APPROVED | REJECTED | IMPORTED

  matchedSchoolId String?
  matchedSchool   School? @relation(fields: [matchedSchoolId], references: [id])

  rejectionReason  String?
  researchNotes    String?
  importedSchoolId String? @unique

  decidedById String?
  decidedBy   User?     @relation("SchoolResearchCandidateDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  sources SchoolResearchSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([researchJobId, status])
  @@index([normalizedName])
  @@index([matchedSchoolId])
}

model SchoolResearchSource {
  id          String                  @id @default(cuid())
  candidateId String
  candidate   SchoolResearchCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  field       String // "name" | "phone" | "email" | "website" | "address" | "schoolType" | "contactPerson"
  sourceType  String // "OFFICIAL_WEBSITE" | "SEARCH_GROUNDING" | "OTHER"
  sourceUrl   String?
  collectedAt DateTime @default(now())

  @@index([candidateId])
}

// Per-API-request usage tracking for AI School Research.
// One row per individual HTTP request to a provider (Groq or Gemini).
// A single research job may produce multiple rows (batches, retries, fallbacks).
// Web searches are tracked separately from API requests — a single Groq compound
// request may internally execute multiple web searches (see executedTools).
model SchoolResearchAttempt {
  id    String            @id @default(cuid())
  jobId String
  job   SchoolResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Provider identity
  provider String // "groq" | "gemini"
  model    String

  // Attempt numbering within this job (1-based, sequential across all providers)
  attemptNumber Int

  // Outcome
  status     String // "SUCCESS" | "FAILED" | "RATE_LIMITED"
  httpStatus Int? // HTTP status code, null on network errors

  // Timing (actual wall-clock, never estimated)
  durationMs  Int
  startedAt   DateTime
  completedAt DateTime

  // Token usage (null when the provider did not return them — never guessed)
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  // Tool executions within this API request
  // webSearches: count of search-type tools executed (NOT equal to apiRequests)
  webSearches   Int     @default(0)
  // executedTools: JSON array of raw tool metadata from Groq compound response
  executedTools String?

  // Classification flags
  isRetry    Boolean @default(false) // came after a RATE_LIMITED attempt
  isFallback Boolean @default(false) // Gemini attempt invoked after Groq failure

  // Error details (sanitized — no API keys or secrets)
  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model SchoolApprovalRequest {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User      @relation("SchoolApprovalRequester", fields: [requesterId], references: [id])
  decidedById     String?
  decidedBy       User?     @relation("SchoolApprovalDecider", fields: [decidedById], references: [id])
  type            String // EDIT | DELETE
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  previousData    String?
  proposedData    String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([status, type])
  @@index([schoolId, createdAt])
  @@index([requesterId])
}

model TicketApprovalRequest {
  id              String    @id @default(cuid())
  ticketId        String
  ticket          Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User      @relation("TicketApprovalRequester", fields: [requesterId], references: [id])
  decidedById     String?
  decidedBy       User?     @relation("TicketApprovalDecider", fields: [decidedById], references: [id])
  type            String // CORRECTION | RESUBMIT
  status          String    @default("PENDING")
  proposedData    String
  rejectionReason String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([status, type])
  @@index([ticketId, createdAt])
  @@index([requesterId])
}

model ChatConversation {
  id           String            @id @default(cuid())
  participants ChatParticipant[]
  messages     ChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([updatedAt])
}

model ChatParticipant {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// Real online/offline/away presence, driven by a client heartbeat (see
// PresenceService). Kept as its own single-row-per-user table rather than
// fields on User so frequent heartbeat writes never touch/lock the User row.
// Status itself is never stored — it's always derived from lastSeenAt at
// read time (PresenceService.deriveStatus), so a browser closed without a
// clean disconnect self-corrects to "offline" once the heartbeat stops,
// instead of getting stuck showing "online" forever.
model UserPresence {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime

  @@index([lastSeenAt])
}

model LoginSession {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress           String?
  deviceInfo          String?
  browser             String?
  operatingSystem     String?
  approximateLocation String?
  loginAt             DateTime  @default(now())
  logoutAt            DateTime?
  denied              Boolean   @default(false)
  expiresAt           DateTime  @default(now())

  @@index([userId, loginAt])
  @@index([ipAddress])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model SchoolAssignment {
  id            String  @id @default(cuid())
  batchNumber   String  @unique // e.g. "ASN-2026-0001"
  title         String
  strategy      String  @default("EQUAL_DISTRIBUTION") // "EQUAL_DISTRIBUTION", "MANUAL"
  totalSchools  Int
  assignedCount Int
  notes         String?

  createdById String
  createdBy   User   @relation("AssignmentCreator", fields: [createdById], references: [id])

  tickets Ticket[]

  createdAt DateTime @default(now())

  @@index([createdById])
  @@index([createdAt])
}

model TaskType {
  id          String  @id @default(cuid())
  name        String
  // Legacy code retained only for historical ticket references. Not user-editable. Not surfaced in UI.
  code        String? @unique
  description String?
  isActive    Boolean @default(true)
  createdById String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  tickets Ticket[]
  members TaskTypeMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([departmentId])
}

model TaskTypeMember {
  id             String   @id @default(cuid())
  taskTypeId     String
  taskType       TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responsibility String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([taskTypeId, userId])
  @@index([userId])
}

model Ticket {
  id           String            @id @default(cuid())
  ticketNumber String            @unique // e.g. "CL-00101"
  schoolId     String?
  school       School?           @relation(fields: [schoolId], references: [id])
  taskTypeId   String?
  taskType     TaskType?         @relation(fields: [taskTypeId], references: [id])
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])
  assignmentId String?
  assignment   SchoolAssignment? @relation(fields: [assignmentId], references: [id])

  subject         String
  priority        String  @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  status          String  @default("PENDING") // "PENDING", "SEEN", "ACCEPTED", "REJECTED", "IN_PROGRESS", "TRANSFERRED", "UNREACHABLE", "COMPLETED", "CLOSED"
  rejectionReason String?

  createdById String
  createdBy   User   @relation("TicketCreator", fields: [createdById], references: [id])

  dueDate    DateTime?
  followUpAt DateTime?

  assignees             TicketAssignee[]
  notes                 Note[]
  attachments           Attachment[]
  communicationAttempts CommunicationAttempt[]
  assignmentHistory     AssignmentHistory[]
  activityEvents        ActivityEvent[]
  calendarEvents        CalendarEvent[]
  meetingDetails        MeetingDetails?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  TicketApprovalRequest TicketApprovalRequest[]

  @@index([status])
  @@index([schoolId])
  @@index([departmentId])
  @@index([taskTypeId])
  @@index([priority])
  @@index([createdAt])
}

// Meeting-specific fields for a Ticket used as a "Meeting Minutes" record.
// Kept 1:1 with Ticket so meeting tickets reuse the normal Ticket lifecycle,
// notes, attachments, assignment, and notifications untouched.
model MeetingDetails {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  meetingDate  DateTime
  meetingTime  String // "HH:mm" (24h)
  // JSON array of { name: string, userId?: string }
  participants String
  // JSON array of { text: string, assigneeId?: string, done: boolean }
  actionItems  String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingDate])
}

model TicketAssignee {
  id           String    @id @default(cuid())
  ticketId     String
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  isCurrent    Boolean   @default(true)
  role         String    @default("ASSIGNEE") // "ASSIGNEE", "CC"
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@index([ticketId, userId])
  @@index([userId, isCurrent])
}

model AssignmentHistory {
  id            String  @id @default(cuid())
  ticketId      String
  ticket        Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromUserId    String?
  fromUser      User?   @relation("AssignFrom", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        User    @relation("AssignTo", fields: [toUserId], references: [id])
  performedById String
  performedBy   User    @relation("AssignPerformed", fields: [performedById], references: [id])
  action        String // "INITIAL_ASSIGNMENT", "TRANSFER", "REASSIGN", "CC_ADDED"
  reason        String?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([toUserId])
  @@index([fromUserId])
}

model Note {
  id               String  @id @default(cuid())
  ticketId         String
  ticket           Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId         String
  author           User    @relation("NoteAuthor", fields: [authorId], references: [id])
  content          String
  priority         String? // Optional note highlight
  transferToUserId String?

  attachments Attachment[]

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model Attachment {
  id              String  @id @default(cuid())
  ticketId        String?
  ticket          Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  noteId          String?
  note            Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  originalName    String
  mimeType        String
  size            Int
  storageKey      String  @unique
  storageProvider String  @default("local")
  uploadedById    String

  createdAt DateTime @default(now())

  @@index([noteId])
  @@index([ticketId])
  @@index([storageKey])
}

model CommunicationAttempt {
  id            String  @id @default(cuid())
  ticketId      String
  ticket        Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   User    @relation("AttemptAuthor", fields: [performedById], references: [id])
  attemptNumber Int
  method        String // "PHONE", "WHATSAPP", "EMAIL", "IN_PERSON", "OTHER"
  result        String // "NO_ANSWER", "BUSY", "ANSWERED", "WRONG_NUMBER", "WHATSAPP_SENT", "EMAIL_SENT", "REPLIED", "CALLBACK_REQUESTED", "INVALID_CONTACT", "OTHER"
  note          String?

  createdAt DateTime @default(now())

  @@index([ticketId, attemptNumber])
  @@index([performedById])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // "TICKET_ASSIGNED", "TICKET_TRANSFERRED", "TICKET_ACCEPTED", "TICKET_REJECTED", "NEW_NOTE", "STATUS_CHANGED", "MENTION"
  title      String
  message    String
  entityType String? // "ticket", "school", "assignment", "todo"
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id])
  action     String // e.g. "AUTH_LOGIN", "TICKET_CREATED", "TICKET_SEEN", "TICKET_ACCEPTED", "TICKET_REJECTED", "TICKET_TRANSFERRED", "NOTE_CREATED", "SCHOOL_IMPORTED"
  entityType String // "Ticket", "School", "Assignment", "User", "Role", "Note", etc.
  entityId   String?
  metadata   String? // JSON string
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model ActivityEvent {
  id          String  @id @default(cuid())
  ticketId    String
  ticket      Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User    @relation("ActivityActor", fields: [actorId], references: [id])
  type        String // "CREATED", "SEEN", "ACCEPTED", "REJECTED", "IN_PROGRESS", "NOTE_ADDED", "TRANSFERRED", "COMMUNICATION_ATTEMPT", "COMPLETED", "CLOSED"
  title       String
  description String?
  metadata    String? // JSON string

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([actorId])
}

model Todo {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserTodos", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  color       String    @default("yellow") // "yellow", "blue", "green", "pink", "purple", "orange"
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isCompleted])
  @@index([userId, createdAt])
}

model Message {
  id          String              @id @default(cuid())
  senderId    String
  sender      User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  subject     String
  content     String
  recipients  MessageRecipient[]
  attachments MessageAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([createdAt])
}

model MessageRecipient {
  id         String    @id @default(cuid())
  messageId  String
  message    Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("ReceivedMessages", fields: [userId], references: [id], onDelete: Cascade)
  type       String    @default("TO") // "TO", "CC"
  isRead     Boolean   @default(false)
  readAt     DateTime?
  isArchived Boolean   @default(false)
  isDeleted  Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, isDeleted])
  @@index([messageId])
}

model MessageAttachment {
  id              String  @id @default(cuid())
  messageId       String
  message         Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  originalName    String
  mimeType        String
  size            Int
  storageKey      String  @unique
  storageProvider String  @default("local")
  uploadedById    String

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([storageKey])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  // "MEETING" | "CALL" | "FOLLOW_UP" | "CONTRACT_SIGNING" | "APPOINTMENT" | "SCHEDULED_TASK" | "DUE_DATE" | "TASK" | "EVENT"
  type        String    @default("MEETING")
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  location    String?

  // Legacy single-assignee field (preserved for backwards compat)
  userId String?
  user   User?   @relation("CalendarAssignedUser", fields: [userId], references: [id])

  // Multi-assignee relation
  assignees CalendarEventAssignee[]

  createdById String
  createdBy   User   @relation("CalendarCreator", fields: [createdById], references: [id])

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
  @@index([createdById])
  @@index([startDate])
  @@index([type])
}

model CalendarEventAssignee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model MessageTemplate {
  id        String  @id @default(cuid())
  code      String  @unique
  title     String
  titleAr   String
  subject   String
  subjectAr String
  content   String
  contentAr String
  category  String  @default("GENERAL") // "MEETING", "PERMISSION", "FOLLOW_UP", "APPROVAL", "NOTICE", "GENERAL"
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ── Proposal Templates ───────────────────────────────────────────────────
// Reusable base PDF templates with bounding box configurations for logos/fields.
model ProposalTemplate {
  id                 String     @id @default(cuid())
  name               String
  description        String?
  pdfStorageKey      String
  pdfStorageProvider String     @default("local")
  originalFileName   String
  fileSize           Int        @default(0)
  isActive           Boolean    @default(true)

  // JSON: { schoolLogoPosition: { page, x, y, width, height }, codeLineLogoPosition: { page, x, y, width, height } }
  config             String?

  createdById        String
  createdBy          User       @relation("ProposalTemplateCreator", fields: [createdById], references: [id])

  proposals          Proposal[]

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([isActive])
  @@index([createdById])
}

// ── Proposals ─────────────────────────────────────────────────────────────
// Stores commercial proposals generated for schools / clients.
model Proposal {
  id            String  @id @default(cuid())
  title         String
  clientName    String
  contactPerson String?
  clientEmail   String?
  clientPhone   String?

  templateId    String?
  template      ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  schoolId      String?
  school        School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  // Snapshot of school logo used at generation time (preserves historical accuracy)
  logoKey       String?
  logoProvider  String            @default("local")

  // DRAFT | GENERATED | SENT
  status        String            @default("DRAFT")

  // JSON blob: { services: [], pricing: [], terms: "", notes: "", dynamicValues: {} }
  content       String?

  generatedAt          DateTime?
  generatedPdfKey      String?
  generatedPdfProvider String    @default("local")

  createdById   String
  createdBy     User              @relation("ProposalCreator", fields: [createdById], references: [id])

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([schoolId])
  @@index([templateId])
  @@index([createdAt])
}

