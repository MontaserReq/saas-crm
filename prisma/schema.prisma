model Ticket {
  id             String            @id @default(cuid())
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticketNumber   String            @unique // e.g. "CL-00101"
  schoolId       String?
  school         School?           @relation(fields: [schoolId], references: [id])
  clientId       String?
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  taskTypeId     String?
  taskType       TaskType?         @relation(fields: [taskTypeId], references: [id])
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id])
  assignmentId   String?
  assignment     SchoolAssignment? @relation(fields: [assignmentId], references: [id])

  subject         String
  priority        String  @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  status          String  @default("PENDING") // "PENDING", "SEEN", "ACCEPTED", "REJECTED", "IN_PROGRESS", "TRANSFERRED", "UNREACHABLE", "COMPLETED", "CLOSED"
  rejectionReason String?

  createdById String
  createdBy   User   @relation("TicketCreator", fields: [createdById], references: [id])

  dueDate    DateTime?
  followUpAt DateTime?

  assignees             TicketAssignee[]
  notes                 Note[]
  attachments           Attachment[]
  communicationAttempts CommunicationAttempt[]
  assignmentHistory     AssignmentHistory[]
  activityEvents        ActivityEvent[]
  crmTasks              CrmTask[]
  calendarEvents        CalendarEvent[]
  meetingDetails        MeetingDetails?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  TicketApprovalRequest TicketApprovalRequest[]

  @@index([status])
  @@index([schoolId])
  @@index([organizationId, clientId])
  @@index([departmentId])
  @@index([taskTypeId])
  @@index([priority])
  @@index([createdAt])
}

