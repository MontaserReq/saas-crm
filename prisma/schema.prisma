  template   ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Snapshot of school logo used at generation time (preserves historical accuracy)
  logoKey      String?
  logoProvider String  @default("local")

  // DRAFT | GENERATED | SENT
  status String @default("DRAFT")

  // JSON blob: { services: [], pricing: [], terms: "", notes: "", dynamicValues: {} }
  content String?

  generatedAt          DateTime?
  generatedPdfKey      String?
  generatedPdfProvider String    @default("local")

  createdById String
  createdBy   User   @relation("ProposalCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([schoolId])
  @@index([organizationId, clientId])
  @@index([templateId])
  @@index([createdAt])
}

model RateLimitCounter {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([expiresAt])
}

// Durable coordination records for expensive synchronous operations. This is
// intentionally separate from RateLimitCounter: rate limits count requests in
// a time window, while this model owns active execution leases and idempotency.
model OperationExecution {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation("OperationExecutionUser", fields: [userId], references: [id], onDelete: SetNull)
  operationType  String
  idempotencyKey String?
  status         String        @default("PENDING")
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  attemptCount   Int           @default(0)
  ownerToken     String?
  resultPayload  String?
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  authoritativeResearchJob SchoolResearchJob? @relation("ResearchJobCurrentOperation")

  @@unique([organizationId, operationType, idempotencyKey])
  @@index([operationType, status, leaseExpiresAt])
  @@index([organizationId, operationType, status])
  @@index([userId, operationType, status])
}
