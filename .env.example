DATABASE_URL=postgresql://user:password@localhost:5432/codelinecrm
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Password reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@codelinejo.com
SMTP_PASSWORD=
EMAIL_FROM=info@codelinejo.com
EMAIL_FROM_NAME=CodeLine JO

# Required only when running prisma db seed
SEED_DEFAULT_PASSWORD=

# Set STORAGE_DRIVER=s3 in production. Keep these server-side only.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false
