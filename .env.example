DATABASE_URL=postgresql://user:password@localhost:5432/codelinecrm
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
RATE_LIMIT_ENABLED=true

# Chatbot proxy configuration. Leave unset to fail closed until the widget
# upstream and its required comma-separated paths are explicitly configured.
CHATBOT_UPSTREAM_ORIGIN=
CHATBOT_WIDGET_URL=
CHATBOT_PROXY_ALLOWED_PATHS=
# Set true only when a trusted reverse proxy sanitizes forwarding headers.
TRUST_PROXY=false

# Password reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@codelinejo.com
SMTP_PASSWORD=
EMAIL_FROM=info@codelinejo.com
EMAIL_FROM_NAME=CodeLine JO

# Required only when running prisma db seed
SEED_DEFAULT_PASSWORD=

# Set STORAGE_DRIVER=s3 in production. Keep these server-side only.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false

# AI School Research (server-side only — never expose as NEXT_PUBLIC_*).
# AI_PROVIDER selects the primary provider: "groq" (web-search compound model,
# with automatic fallback to Gemini) or anything else / unset (Gemini only).
AI_PROVIDER=gemini

# Leave GROQ_API_KEY empty to skip Groq and use Gemini only.
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
# Keep this comfortably under your Groq account's tokens-per-minute (TPM)
# tier — some tiers cap as low as 8000 TPM, and a request whose own
# max_completion_tokens exceeds the remaining budget is rejected outright
# with 413 Request Entity Too Large before any generation happens.
GROQ_MAX_COMPLETION_TOKENS=4096

# Leave GEMINI_API_KEY empty to keep the feature in its "not configured" state.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

AI_RESEARCH_MAX_SCHOOLS=100
AI_RESEARCH_MAX_SOURCE_REQUESTS_PER_SCHOOL=3
AI_RESEARCH_MAX_PROVIDER_REQUESTS=24
AI_RESEARCH_MAX_SOURCE_REQUESTS=60
AI_RESEARCH_MAX_RETRIES=8
AI_RESEARCH_MAX_TOKENS=100000
AI_RESEARCH_MAX_DURATION_MS=900000

# AI Knowledge Assistant (read-only chatbot — server-side only, reuses the
# GROQ_API_KEY / GEMINI_API_KEY above). Uses plain chat-completion models
# (no web-search/compound tools) since it only answers from CRM data the
# server already fetched, never the open web.
# Groq: fast/cheap intent classification for every message.
GROQ_ASSISTANT_MODEL=llama-3.1-8b-instant
# Gemini Flash-Lite: only for summarizing/phrasing multi-result answers.
GEMINI_ASSISTANT_MODEL=gemini-2.0-flash-lite
