DATABASE_URL=postgresql://user:password@localhost:5432/codelinecrm
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Optional GA4 Measurement ID, for example G-XXXXXXXXXX. Tracking starts only
# after the visitor accepts analytics in the privacy banner.
GA_MEASUREMENT_ID=

# Rate limiting is always enabled and fails closed for protected operations.

# Smart CRM import synchronous safety bounds. The defaults shown here are
# enforced server-side; raising them requires a background-job design review.
CRM_IMPORT_MAX_FILE_BYTES=5242880
CRM_IMPORT_MAX_ROWS=2000
CRM_IMPORT_MAX_COLUMNS=80
CRM_IMPORT_MAX_CELLS=100000

# Company email/calendar OAuth (server-side secrets; do not use NEXT_PUBLIC_)
# Google Cloud OAuth client: Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra App Registration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Required in production; used to encrypt stored provider tokens
INTEGRATION_ENCRYPTION_KEY=

# Chatbot proxy configuration. Leave unset to fail closed until the widget
# upstream and its required comma-separated paths are explicitly configured.
CHATBOT_UPSTREAM_ORIGIN=
CHATBOT_WIDGET_URL=
CHATBOT_PROXY_ALLOWED_PATHS=
# Set true only when a trusted reverse proxy sanitizes forwarding headers.
TRUST_PROXY=false

# Password reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@codelinejo.com
SMTP_PASSWORD=
EMAIL_FROM=info@codelinejo.com
EMAIL_FROM_NAME=CodeLine JO

# Required only when running prisma db seed
SEED_DEFAULT_PASSWORD=

# Set STORAGE_DRIVER=s3 in production. Keep these server-side only.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false

# AI School Research (server-side only — never expose as NEXT_PUBLIC_*).
# AI_PROVIDER selects the primary provider: "groq" (web-search compound model,
# with automatic fallback to Gemini) or anything else / unset (Gemini only).
AI_PROVIDER=gemini

# Leave GROQ_API_KEY empty to skip Groq and use Gemini only.
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
# Keep this comfortably under your Groq account's tokens-per-minute (TPM)
# tier — some tiers cap as low as 8000 TPM, and a request whose own
# max_completion_tokens exceeds the remaining budget is rejected outright
# with 413 Request Entity Too Large before any generation happens.
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_BATCH_SIZE=5

# Leave GEMINI_API_KEY empty to keep the feature in its "not configured" state.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

AI_RESEARCH_MAX_SCHOOLS=100
AI_RESEARCH_MAX_SOURCE_REQUESTS_PER_SCHOOL=3
AI_RESEARCH_MAX_PROVIDER_REQUESTS=24
AI_RESEARCH_MAX_SOURCE_REQUESTS=60
AI_RESEARCH_MAX_RETRIES=8
AI_RESEARCH_MAX_TOKENS=100000
AI_RESEARCH_MAX_DURATION_MS=900000

# Durable-operation concurrency and lease controls. Defaults are conservative;
# tune only after measuring the release environment and provider quotas.
AI_RESEARCH_GLOBAL_CONCURRENCY=2
AI_RESEARCH_ORG_CONCURRENCY=1
AI_RESEARCH_USER_CONCURRENCY=1
AI_RESEARCH_LEASE_MS=1200000
AI_ASSISTANT_GLOBAL_CONCURRENCY=8
AI_ASSISTANT_ORG_CONCURRENCY=3
AI_ASSISTANT_USER_CONCURRENCY=1
AI_ASSISTANT_LEASE_MS=120000
PROPOSAL_GENERATION_GLOBAL_CONCURRENCY=4
PROPOSAL_GENERATION_ORG_CONCURRENCY=2
PROPOSAL_GENERATION_USER_CONCURRENCY=1
PROPOSAL_GENERATION_LEASE_MS=300000
SCHOOL_IMPORT_GLOBAL_CONCURRENCY=4
SCHOOL_IMPORT_ORG_CONCURRENCY=2
SCHOOL_IMPORT_USER_CONCURRENCY=1
SCHOOL_IMPORT_LEASE_MS=600000

# AI Knowledge Assistant (read-only chatbot — server-side only, reuses the
# GROQ_API_KEY / GEMINI_API_KEY above). Uses plain chat-completion models
# (no web-search/compound tools) since it only answers from CRM data the
# server already fetched, never the open web.
# Groq: fast/cheap intent classification for every message.
GROQ_ASSISTANT_MODEL=llama-3.1-8b-instant
# Gemini Flash-Lite: only for summarizing/phrasing multi-result answers.
GEMINI_ASSISTANT_MODEL=gemini-2.0-flash-lite
